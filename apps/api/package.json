    "@koode/contracts": "workspace:*",
    "@koode/database": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"

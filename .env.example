# Copy to .env for local development. Never commit real secrets.

# Web
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# API
API_PORT=3001
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001

# Required. Must be at least 32 characters. No default in code.
SESSION_SECRET=dev-session-secret-change-me-32chars

# Fail closed by default. Set true only for local demos (returns magic link in API).
MAGIC_LINK_DEV_MODE=true

# Cookie Secure flag. Defaults to true when NODE_ENV=production.
# Keep false for local http://localhost.
COOKIE_SECURE=false

# Postgres (docker compose maps host 5433 -> container 5432)
DATABASE_URL=postgres://koode:koode@localhost:5433/koode

# Model-agnostic AI gateway
# AI_PROVIDER=stub | openai-compatible
AI_PROVIDER=stub
# For openai-compatible (OpenAI, Groq, Ollama, Azure-compatible gateways, etc.):
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=

# Observability / limits (no extra packages)
LOG_LEVEL=info
# RATE_LIMIT_MAGIC_LINK_MAX=10
# RATE_LIMIT_MAGIC_LINK_WINDOW_MS=900000
# RATE_LIMIT_TUTOR_MAX=60
# RATE_LIMIT_TUTOR_WINDOW_MS=60000


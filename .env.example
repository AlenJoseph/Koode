# Copy to .env for local development. Never commit real secrets.

# Web
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# API
API_PORT=3001
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001

# Required. Must be at least 32 characters. No default in code.
SESSION_SECRET=dev-session-secret-change-me-32chars

# Fail closed by default. Set true only for local demos (returns magic link in API).
MAGIC_LINK_DEV_MODE=true

# Cookie Secure flag. Defaults to true when NODE_ENV=production.
# Keep false for local http://localhost.
COOKIE_SECURE=false

# Postgres (docker compose maps host 5433 -> container 5432)
DATABASE_URL=postgres://koode:koode@localhost:5433/koode

# Optional LLM demos later — tests must keep using the stub provider
# OPENAI_API_KEY=

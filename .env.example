# Copy to .env for local development. Never commit real secrets.

# Web
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# API
API_PORT=3001
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
SESSION_SECRET=dev-session-secret-change-me-32chars
MAGIC_LINK_DEV_MODE=true

# Postgres (docker compose maps host 5433 -> container 5432)
DATABASE_URL=postgres://koode:koode@localhost:5433/koode

